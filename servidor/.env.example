# Dados do SERVIDOR (este arquivo fica só no seu PC, nunca vai para os convidados).
PORT=3000

# Pasta dos dados (contas, sessões, chats, uploads). Se vazio, usa  <sua pasta de usuário>/GlugluCall-dados,
# que fica FORA do projeto: atualizar a versão não apaga contas e nunca vai para o GitHub.
# DATA_DIR=C:\GlugluCall-dados

# Endereço público: o servidor testa sozinho se o domínio chega até ele e avisa no terminal
# (✔ ONLINE / ✖ OFFLINE). Deixe vazio para desativar.
PUBLIC_URL=https://gluglutelas.website

# Token do túnel Cloudflare (opcional). Se preencher, o servidor liga o cloudflared junto
# (precisa do cloudflared instalado). Se você já instalou o túnel como serviço do Windows,
# deixe VAZIO para não duplicar.
# TUNNEL_TOKEN=

# Senha da sala (opcional). Se vazia, qualquer pessoa com o link entra.
# ROOM_PASSWORD=troque-esta-senha

# Servidor TURN (recomendado para 4G/redes restritas):
# TURN_URL=turn:turn.exemplo.com:3478
# TURN_USER=usuario
# TURN_PASS=senha

# YouTube Data API v3 (opcional; habilita buscar música pelo nome)
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# E-mail (código de verificação do cadastro)
# Sem SMTP_HOST o servidor fica em MODO TESTE: o código aparece só na janela do
# servidor e nenhum e-mail sai. Para enviar de verdade, preencha:
#
# Exemplo com Gmail (precisa de verificação em duas etapas + "Senha de app"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seuemail@gmail.com
#   SMTP_PASS=senha-de-app-de-16-letras
#   MAIL_FROM=GlugluCall <seuemail@gmail.com>
# Também serve qualquer SMTP (Brevo, Resend, Mailgun, Outlook...). Porta 465 liga SSL sozinha.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=GlugluCall <no-reply@gluglutelas.website>
